#!/bin/bash
# Qwen3.5-122B-A10B INT4 on Spiegel 2 (RTX PRO 6000, SM120)
# TORCH_CUDNN_V8_API_DISABLED=1: cuDNN conv3d has no SM120 engine for GatedDeltaNet
# --enforce-eager: skip CUDA graph capture (causal_conv1d assertion bug)
# --max-model-len 32768: 100K causes OOM (model=63GB + KV-cache)

podman run -d   --replace   --name vllm-qwen35-122b   --device nvidia.com/gpu=all   --security-opt=label=disable   --hooks-dir=/usr/share/containers/oci/hooks.d   -p 8011:8000   -v /data/tensordata:/data/tensordata   -e VLLM_DISABLED_KERNELS=CutlassFP8ScaledMMLinearKernel   -e TORCH_CUDNN_V8_API_DISABLED=1   localhost/vllm-ng17   vllm serve /data/tensordata/Qwen3.5-122B-A10B-int4-AutoRound     --host 0.0.0.0     --port 8000     --served-model-name qwen3.5-122b     --gpu-memory-utilization 0.90     --max-model-len 32768     --trust-remote-code     --tool-call-parser hermes     --enable-auto-tool-choice     --chat-template-content-format string     --enforce-eager
